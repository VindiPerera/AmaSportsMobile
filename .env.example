# Base URL of the Laravel API, including the /api prefix.
# - iOS simulator: http://127.0.0.1:8000/api
# - Android emulator: http://10.0.2.2:8000/api
# - Physical device: http://<your-machine-lan-ip>:8000/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Firebase project the Live Score screens subscribe to for real-time score
# ticks (collection `live_scores`, doc id = match id — pushed server-side by
# the backend admin panel's FirebaseLiveScoreService). Leave all blank to
# run on the built-in local simulation instead. Get these from Firebase
# Console -> Project Settings -> General -> Your apps -> Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
